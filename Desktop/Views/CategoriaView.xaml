<UserControl x:Class="FinanceControlDesktop.Views.CategoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FinanceControlDesktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: formulário de adicionar -->
            <RowDefinition Height="*"/>      <!-- Row 1: lista (ocupa o espaço que sobra) -->
            <RowDefinition Height="Auto"/>   <!-- Row 2: botão remover -->
        </Grid.RowDefinitions>

        <!-- Formulário: campo do nome + botão adicionar, lado a lado -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <!-- UpdateSourceTrigger=PropertyChanged: atualiza a VM a cada tecla (não só ao sair do campo) -->
            <TextBox Width="250"
             Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
            <!-- Command dispara o método da VM; o CanExecute habilita/desabilita o botão -->
            <Button Content="Adicionar"
            Command="{Binding AdicionarCommand}"
            Margin="8,0,0,0" Padding="12,4"/>
        </StackPanel>

        <!-- Lista de categorias; SelectedItem amarra a categoria clicada à VM -->
        <ListBox Grid.Row="1"
     ItemsSource="{Binding Categorias}"
     SelectedItem="{Binding CategoriaSelecionada}"
     DisplayMemberPath="Nome"/>   <!-- mostra a propriedade Nome de cada objeto Categoria -->

        <!-- Remove a categoria selecionada na lista -->
        <Button Grid.Row="2"
    Content="Remover selecionada"
    Command="{Binding RemoverCommand}"
    HorizontalAlignment="Right"
    Margin="0,12,0,0" Padding="12,4"/>
    </Grid>
</UserControl>
