<UserControl x:Class="FinanceControlDesktop.Views.CategoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FinanceControlDesktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Converte bool -> Visibility (Visible/Collapsed). Nativo do WPF -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: nova categoria -->
            <RowDefinition Height="*"/>
            <!-- Row 1: lista -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: painel de edição (só em modo edição) -->
        </Grid.RowDefinitions>

        <!-- Nova categoria -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Width="250"
                     Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Adicionar"
                    Command="{Binding AdicionarCommand}"
                    Margin="8,0,0,0" Padding="12,4"/>
        </StackPanel>

        <!-- Lista: cada item mostra o nome + botão Editar (só na linha selecionada) -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Categorias}"
                 SelectedItem="{Binding CategoriaSelecionada}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Nome}" VerticalAlignment="Center"/>
                        <!-- Command sobe até a VM (RelativeSource); visível só se o item está selecionado -->
                        <Button Grid.Column="1" Content="Editar" Padding="10,2"
                                Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Painel de edição: aparece só quando ModoEdicao = true -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0"
                    Visibility="{Binding ModoEdicao, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Editar selecionada" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding NomeEdicao, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Salvar"
                        Command="{Binding SalvarCommand}" Margin="8,0,0,0" Padding="12,4"/>
                <Button Grid.Column="2" Content="Remover"
                        Command="{Binding RemoverCommand}" Margin="8,0,0,0" Padding="12,4"/>
            </Grid>
            <TextBlock Text="{Binding MensagemExcluir}" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>