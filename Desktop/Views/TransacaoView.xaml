<UserControl x:Class="FinanceControlDesktop.Views.TransacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FinanceControlDesktop.Views"
             xmlns:conv="clr-namespace:FinanceControlDesktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TipoParaCorConverter x:Key="TipoCor"/>
        <conv:TipoParaSetaConverter x:Key="TipoSeta"/>
        <conv:ValorComSinalConverter x:Key="ValorSinal"/>
        <conv:EnumParaTextoConverter x:Key="EnumTexto"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: formulário -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: título Histórico + botão Filtros -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: painel de filtros (recolhível) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: lista -->
        </Grid.RowDefinitions>

        <!-- Formulário de nova transação (serve também pro modo edição) -->
        <StackPanel Grid.Row="0">

            <!-- Faixa "Editando" (só aparece em modo edição) -->
            <TextBlock Text="Editando transação" FontWeight="SemiBold" Margin="0,0,0,8"
                       Visibility="{Binding ModoEdicao, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="Descrição"/>
            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

            <!-- Linha com Valor e Data lado a lado -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Valor"/>
                    <!-- PreviewTextInput: bloqueia digitar mais de 2 casas decimais -->
                    <TextBox Text="{Binding Valor}" Margin="0,2,0,0" PreviewTextInput="Valor_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Data"/>
                    <DatePicker SelectedDate="{Binding Data}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Linha com Tipo e Categoria lado a lado -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tipo"/>
                    <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecionado}" Margin="0,2,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumTexto}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Categoria"/>
                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" DisplayMemberPath="Nome" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Botões: Adicionar (modo normal) ↔ Salvar/Cancelar (modo edição) -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Adicionar transação" Command="{Binding AdicionarCommand}" Padding="12,6">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoEdicao}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Salvar edição" Command="{Binding SalvarCommand}" Padding="12,6"
                        Visibility="{Binding ModoEdicao, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Cancelar" Command="{Binding CancelamentoCommand}" Padding="12,6" Margin="8,0,0,0"
                        Visibility="{Binding ModoEdicao, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

        </StackPanel>

        <!-- Título Histórico + botão Filtros (alterna o painel) -->
        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Histórico" FontSize="15" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Filtros" Command="{Binding AlternarFiltrosCommand}" Padding="12,4"/>
        </Grid>

        <!-- Painel de filtros: aparece só quando FiltrosVisiveis = true -->
        <Border Grid.Row="2" Margin="0,0,0,10" Padding="10" CornerRadius="6"
                BorderBrush="#33888888" BorderThickness="1"
                Visibility="{Binding FiltrosVisiveis, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Início" FontSize="11"/>
                    <DatePicker SelectedDate="{Binding DataInicio}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fim" FontSize="11"/>
                    <DatePicker SelectedDate="{Binding DataFim}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Tipo" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoFiltro}" Margin="0,2,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumTexto}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Categoria" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaFiltro}" DisplayMemberPath="Nome" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Filtrar + Limpar -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Filtrar" Command="{Binding FiltrarCommand}" Padding="16,6" Margin="0,0,6,0"/>
                    <Button Content="Limpar" Command="{Binding LimparFiltrosCommand}" Padding="16,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista: SelectedItem -> TransacaoSelecionada; Editar/Excluir só na linha selecionada -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Transacoes}"
                 SelectedItem="{Binding TransacaoSelecionada}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Badge primeiro: largura fixa + conteúdo centralizado -->
                            <Border Background="{Binding Tipo, Converter={StaticResource TipoCor}, ConverterParameter=Fundo}"
                                    CornerRadius="20" Padding="9,3" Margin="0,0,12,0" VerticalAlignment="Center" Width="95">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Tipo, Converter={StaticResource TipoSeta}}"
                                               Foreground="{Binding Tipo, Converter={StaticResource TipoCor}, ConverterParameter=Texto}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Tipo, Converter={StaticResource EnumTexto}}" FontSize="12"
                                               Foreground="{Binding Tipo, Converter={StaticResource TipoCor}, ConverterParameter=Texto}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Data, StringFormat=dd/MM/yyyy}" Width="90" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Descricao}" Width="160" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Categoria.Nome}" Width="120" VerticalAlignment="Center"/>

                            <!-- Valor colorido + sinal (MultiBinding Tipo + Valor) -->
                            <TextBlock Width="110" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{Binding Tipo, Converter={StaticResource TipoCor}}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ValorSinal}">
                                        <Binding Path="Tipo"/>
                                        <Binding Path="Valor"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- Editar + Excluir: só na linha selecionada -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}">
                            <Button Content="Editar" Padding="10,2" Margin="0,0,6,0"
                                    Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            <Button Content="Excluir" Padding="10,2"
                                    Foreground="#A32D2D" BorderBrush="#F0999B"
                                    Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>