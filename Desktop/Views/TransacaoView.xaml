<UserControl x:Class="FinanceControlDesktop.Views.TransacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FinanceControlDesktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: formulário -->
            <RowDefinition Height="*"/>
            <!-- Row 1: lista -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <!-- Faixa "Editando" (só em modo edição) -->
            <TextBlock Text="Editando transação" FontWeight="SemiBold" Margin="0,0,0,8"
                       Visibility="{Binding ModoEdicao, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="Descrição"/>
            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Valor"/>
                    <!-- PreviewTextInput: bloqueia digitar mais de 2 casas decimais -->
                    <TextBox Text="{Binding Valor}" Margin="0,2,0,0" PreviewTextInput="Valor_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Data"/>
                    <DatePicker SelectedDate="{Binding Data}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tipo"/>
                    <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecionado}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Categoria"/>
                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" DisplayMemberPath="Nome" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Botões: Adicionar (normal) ↔ Salvar/Cancelar (edição) -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Adicionar transação" Command="{Binding AdicionarCommand}" Padding="12,6">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoEdicao}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Salvar edição" Command="{Binding SalvarCommand}" Padding="12,6"
                        Visibility="{Binding ModoEdicao, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Cancelar" Command="{Binding CancelamentoCommand}" Padding="12,6" Margin="8,0,0,0"
                        Visibility="{Binding ModoEdicao, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding MensagemErro}" Foreground="Red" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

        </StackPanel>

        <!-- Lista: SelectedItem -> TransacaoSelecionada; botão Editar só na linha selecionada -->
        <ListBox Grid.Row="1" Margin="0,12,0,0"
                 ItemsSource="{Binding Transacoes}"
                 SelectedItem="{Binding TransacaoSelecionada}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Data, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <TextBlock Text="{Binding Tipo}" Width="70"/>
                            <TextBlock Text="{Binding Descricao}" Width="160"/>
                            <TextBlock Text="{Binding Categoria.Nome}" Width="120"/>
                            <TextBlock Text="{Binding Valor, StringFormat=C}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Editar" Padding="10,2"
                                Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>