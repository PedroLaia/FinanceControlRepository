<ui:FluentWindow x:Class="FinanceControlDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinanceControlDesktop"
        xmlns:view="clr-namespace:FinanceControlDesktop.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Finance Control" Height="450" Width="800"
        Icon="Assets/finance-control.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- barra de título -->
            <RowDefinition Height="*"/>
            <!-- conteúdo (abas) -->
        </Grid.RowDefinitions>

        <!-- Barra de título moderna da WPF UI -->
        <ui:TitleBar Grid.Row="0" Title="Finance Control"/>

        <!-- Abas, uma por tela -->
        <TabControl Grid.Row="1" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Categorias">
                <view:CategoriaView DataContext="{Binding CategoriaVM}"/>
            </TabItem>
            <TabItem Header="Transações">
                <view:TransacaoView DataContext="{Binding TransacaoVM}"/>
            </TabItem>
            <TabItem Header="Histórico">
                <view:HistoricoView DataContext="{Binding HistoricoVM}"/>
            </TabItem>
            <TabItem Header="Resumo">
                <view:ResumoView DataContext="{Binding ResumoVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>