<Window x:Class="FinanceControlDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinanceControlDesktop" 
        xmlns:view="clr-namespace:FinanceControlDesktop.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <TabControl SelectionChanged="TabControl_SelectionChanged">
        <TabItem Header="Categorias">
            <view:CategoriaView DataContext="{Binding CategoriaVM}"/>
        </TabItem>
        <TabItem Header="Transações">
            <view:TransacaoView DataContext="{Binding TransacaoVM}"/>
        </TabItem>
        <TabItem Header="Histórico">
            <view:HistoricoView DataContext="{Binding HistoricoVM}"/>
        </TabItem>
        <TabItem Header="Resumo">
            <view:ResumoView DataContext="{Binding ResumoVM}"/>
        </TabItem>
    </TabControl>
</Window>
