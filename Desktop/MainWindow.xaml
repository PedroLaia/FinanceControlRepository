<ui:FluentWindow x:Class="FinanceControlDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinanceControlDesktop"
        xmlns:view="clr-namespace:FinanceControlDesktop.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Finance Control" Height="450" Width="800"
        Icon="Assets/finance-control.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- Converte bool -> Visibility (mostra o snackbar quando Visivel = true) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- barra de título -->
            <RowDefinition Height="*"/>
            <!-- conteúdo (abas) + snackbar sobreposto -->
        </Grid.RowDefinitions>

        <!-- Barra de título moderna da WPF UI -->
        <ui:TitleBar Grid.Row="0" Title="Finance Control"/>

        <!-- Abas, uma por tela -->
        <TabControl Grid.Row="1" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Categorias">
                <view:CategoriaView DataContext="{Binding CategoriaVM}"/>
            </TabItem>
            <TabItem Header="Transações">
                <view:TransacaoView DataContext="{Binding TransacaoVM}"/>
            </TabItem>
            <TabItem Header="Histórico">
                <view:HistoricoView DataContext="{Binding HistoricoVM}"/>
            </TabItem>
            <TabItem Header="Resumo">
                <view:ResumoView DataContext="{Binding ResumoVM}"/>
            </TabItem>
        </TabControl>

        <!-- Snackbar: flutua no rodapé, sobre as abas. Aparece quando NotificacaoVM.Visivel = true -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="16" CornerRadius="10"
                Background="#1F2430" Padding="12,10"
                Visibility="{Binding NotificacaoVM.Visivel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ícone em círculo -->
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#55E04B4A"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="⚠" FontSize="15" Foreground="#F09595"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Título + mensagem -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NotificacaoVM.Titulo}" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding NotificacaoVM.Mensagem}" Foreground="#C3C9D4" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Fechar manual (além do sumiço automático) -->
                <Button Grid.Column="2" Content="✕" Command="{Binding NotificacaoVM.EsconderCommand}"
                        Background="Transparent" BorderBrush="Transparent" Foreground="#9AA3B2"
                        VerticalAlignment="Top" Padding="6,2" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>